{
  "name": "elo-service",
  "version": "1.0.0",
  "description": "Elo 逐场等级分更新与历史更正重算后端（TypeScript + Node.js + SQLite）",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "elo": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
    "serve": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "demo": "tsx examples/demo.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.0"
  }
}
